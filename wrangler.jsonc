{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billowing-forest-66bc",
  "compatibility_date": "2026-08-04",
  "main": "worker.js",
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
